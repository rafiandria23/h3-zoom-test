{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "schedule:weekly"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automerge non-breaking updates for stable (>=1.0) packages once CI passes",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Nx updates ship code migrations; apply them manually via `nx migrate`",
      "matchPackageNames": ["nx", "@nx/**"],
      "automerge": false
    }
  ]
}
