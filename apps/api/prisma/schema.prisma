// Prisma schema for the `api` app.
// Config: apps/api/prisma.config.ts
// Run the CLI via Nx (loads workspace-root .env, sets cwd):
//   nx run @rafiandria23/h3-zoom-test-api:prisma -- db push
//   nx run @rafiandria23/h3-zoom-test-api:prisma -- generate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  text
  long_text
  numeric
  file
}

enum EventType {
  item_submitted
  item_processed
}

model Item {
  id           String      @id @default(uuid())
  content_type ContentType
  label        String
  value        Json?
  file_ref     String?
  mime_type    String?
  size         Int?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  events Event[]

  @@index([created_at])
  @@map("items")
}

model Event {
  id          String    @id @default(uuid())
  type        EventType
  payload     Json?
  occurred_at DateTime  @default(now())

  item_id String
  item    Item   @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id])
  @@index([item_id, type])
  @@map("events")
}
