{
  "name": "@rafiandria23/h3-zoom-test-web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "options": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "dev": {
        "options": {
          "args": "-H ${WEB_HOST:-127.0.0.1} -p ${WEB_PORT:-4000}"
        }
      },
      "start": {
        "options": {
          "args": "-H ${WEB_HOST:-127.0.0.1} -p ${WEB_PORT:-4000}"
        }
      }
    }
  },
  "dependencies": {
    "@rafiandria23/h3-zoom-test-api-client": "workspace:*",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
