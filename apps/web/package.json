{
  "name": "@rafiandria23/h3-zoom-test-web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "options": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "dev": {
        "options": {
          "args": "-H ${WEB_HOST:-127.0.0.1} -p ${WEB_PORT:-4000}"
        }
      },
      "start": {
        "options": {
          "args": "-H ${WEB_HOST:-127.0.0.1} -p ${WEB_PORT:-4000}"
        }
      }
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/themes": "^3.3.0",
    "@rafiandria23/h3-zoom-test-api-client": "workspace:*",
    "@reduxjs/toolkit": "^2.12.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.86.0",
    "react-redux": "^9.3.0",
    "react-virtuoso": "^4.18.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest-environment-jsdom": "~30.3.0"
  }
}
