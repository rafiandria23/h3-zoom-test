{
  "name": "@rafiandria23/h3-zoom-test-api-e2e",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "axios": "^1.6.0"
  },
  "nx": {
    "implicitDependencies": [
      "@rafiandria23/h3-zoom-test-api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@rafiandria23/h3-zoom-test-api:build",
          "@rafiandria23/h3-zoom-test-api:serve"
        ],
        "options": {
          "jestConfig": "apps/api-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
