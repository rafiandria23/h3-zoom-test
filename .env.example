# Copy to .env at the workspace root. Loaded (first value wins) in this order,
# where <mode> = NODE_ENV (development | dev | test | testing | ...):
#   .env.<mode>.local -> .env.local (skipped for test/testing) -> .env.<mode> -> .env
# The real environment always overrides file values. docker-compose reads ./.env.

NODE_ENV=development

LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=3000

WEB_SCHEME=http
WEB_HOST=127.0.0.1
WEB_PORT=4000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=rafiandria23
DB_PASSWORD=rafiandria23
DB_NAME=h3_zoom_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=rafiandria23
REDIS_PASSWORD=rafiandria23
REDIS_DB_INDEX=0
