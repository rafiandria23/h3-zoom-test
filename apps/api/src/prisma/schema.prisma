// Prisma schema for the `api` app.
// Config: apps/api/prisma.config.ts
// Run the CLI via Nx (loads workspace-root .env, sets cwd):
//   nx run @rafiandria23/h3-zoom-test-api:prisma -- db push
//   nx run @rafiandria23/h3-zoom-test-api:prisma -- generate

generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  text
  longText
  numeric
  file
}

enum EventType {
  item_submitted
  item_processed
}

model Item {
  id          String      @id @default(uuid())
  contentType ContentType @map("content_type")
  label       String
  value       Json?
  fileRef     String?     @map("file_ref")
  mimeType    String?     @map("mime_type")
  size        Int?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  events Event[]

  @@index([createdAt])
  @@map("items")
}

model Event {
  id         String    @id @default(uuid())
  type       EventType
  payload    Json?
  occurredAt DateTime  @default(now()) @map("occurred_at")

  itemId String @map("item_id")
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, type])
  @@map("events")
}
