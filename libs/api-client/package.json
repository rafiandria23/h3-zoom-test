{
  "name": "@rafiandria23/h3-zoom-test-api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-redux": "^9.0.0"
  },
  "devDependencies": {
    "@rtk-query/codegen-openapi": "^2.2.0"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:data-access"
    ],
    "targets": {
      "codegen": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "@rafiandria23/h3-zoom-test-api:openapi"
        ],
        "inputs": [
          "{workspaceRoot}/apps/api/openapi.json",
          "{projectRoot}/openapi-config.json"
        ],
        "outputs": [
          "{projectRoot}/src/lib/generated.ts"
        ],
        "options": {
          "command": "rtk-query-codegen-openapi openapi-config.json",
          "cwd": "libs/api-client"
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  }
}
